@page "/fetchproducts"
@inject ProductService ProductService

<PageTitle>Product List</PageTitle>

<h3>Product List</h3>

<button class="refresh" @onclick="() => LoadAsync(refresh: true)" disabled="@loading">Refresh</button>

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (error is not null)
{
    <p class="error">@error</p>
}
else if (products.Length == 0)
{
    <p>No products found.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th></tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr @key="product.Id">
                    <td>@product.Name</td>
                    <td>@(product.Category?.Name ?? "-")</td>
                    <td>@product.Price.ToString("C")</td>
                    <td class="@(product.Stock == 0 ? "out" : "")">@(product.Stock == 0 ? "Out of stock" : product.Stock)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Product[] products = [];
    private string? error;
    private bool loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync(bool refresh = false)
    {
        loading = true;
        error = null;
        try
        {
            products = await ProductService.GetProductsAsync(refresh);
        }
        catch (ProductServiceException ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
